# Database
DATABASE_URL="mysql://username:password@localhost:3306/monthly_renaissance"

# Auth.js (NextAuth v5)
AUTH_SECRET="generate-with: npx auth secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

AUTH_TRUST_HOST="true"
AUTH_URL="https://temp-domain.hostingersite.com" / your domain

# Persistent uploads directory. MUST be outside the deployed app folder
# so it survives redeploys. On Hostinger: /home/<user>/persistent/uploads.
# Locally: a folder in your home dir, e.g. /home/you/mr-uploads.
UPLOAD_DIR="/absolute/path/to/persistent/uploads"